{
  "name": "stevelin-notes",
  "version": "1.0.0",
  "private": true,
  "description": "個人筆記專案：以 NoteCraftApp 呈現 docs/ 下的 md/mdx 筆記，搭配 AI 生成的圖文互動視覺化元件",
  "type": "module",
  "scripts": {
    "notes:dev": "notecraftapp view ./docs",
    "notes:dev:lan": "notecraftapp view ./docs --host 0.0.0.0",
    "notes:serve": "notecraftapp serve ./docs",
    "notes:serve:static": "notecraftapp serve ./docs --no-watch",
    "notes:build": "notecraftapp build ./docs",
    "notes:build:force": "notecraftapp build ./docs --rebuild",
    "skill:install": "notecraftapp init-skill",
    "skill:check": "notecraftapp init-skill --check",
    "skill:update": "notecraftapp init-skill --force",
    "plugin:list": "notecraftapp install-plugin --list",
    "plugin:install": "notecraftapp install-plugin",
    "plugin:remove": "notecraftapp install-plugin --remove",
    "projects:install": "npm --prefix projects install",
    "api:dev": "npm --prefix projects run dev -- --filter=nestjs-api-scaffold",
    "api:build": "npm --prefix projects run build -- --filter=nestjs-api-scaffold",
    "api:start": "npm --prefix projects run start -- --filter=nestjs-api-scaffold",
    "api:test": "npm --prefix projects run test -- --filter=nestjs-api-scaffold",
    "api:test:e2e": "npm --prefix projects run test:e2e -- --filter=nestjs-api-scaffold",
    "api:test:all": "npm --prefix projects/apps/nestjs-api-scaffold run test:all",
    "api:report:generate": "npm --prefix projects/apps/nestjs-api-scaffold run report:generate",
    "api:report:open": "npm --prefix projects/apps/nestjs-api-scaffold run report:open",
    "api:report:watch": "npm --prefix projects/apps/nestjs-api-scaffold run report:watch",
    "api:openapi:export": "npm --prefix projects/apps/nestjs-api-scaffold run openapi:export",
    "api:client:generate": "npm --prefix projects/packages/api-client run generate"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "devDependencies": {
    "notecraftapp": "^1.11.0"
  }
}
