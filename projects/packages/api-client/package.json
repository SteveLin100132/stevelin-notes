{
  "name": "api-client",
  "version": "0.1.0",
  "private": true,
  "description": "由 nestjs-api-scaffold 的 OpenAPI spec 以 Orval 產生的 React（TanStack Query）API client",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "scripts": {
    "generate": "npm run openapi:export -w nestjs-api-scaffold && orval",
    "generate:only": "orval",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "@tanstack/react-query": "^5.0.0",
    "react": ">=18"
  },
  "devDependencies": {
    "@faker-js/faker": "^10.0.0",
    "@tanstack/react-query": "^5.104.0",
    "@types/react": "^19.0.0",
    "msw": "^2.0.0",
    "orval": "^8.39.0",
    "react": "^19.0.0",
    "typescript": "^5.9.0"
  },
  "exports": {
    ".": "./src/index.ts",
    "./mocks": "./src/mocks.ts"
  }
}
