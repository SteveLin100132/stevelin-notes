{
  "name": "nestjs-api-scaffold",
  "version": "0.1.0",
  "private": true,
  "description": "NestJS 後端 API 腳手架（health、metrics、Swagger、rate limit、graceful shutdown）",
  "directories": {
    "test": "test"
  },
  "scripts": {
    "postinstall": "npm rebuild better-sqlite3 --update-binary || true",
    "dev": "nest start --watch",
    "start:dev": "nest start --watch",
    "build": "nest build",
    "start": "node dist/main",
    "test": "node -e \"require('fs').rmSync('allure-results',{recursive:true,force:true})\" && jest",
    "test:cov": "jest --coverage",
    "test:e2e": "node -e \"require('fs').rmSync('allure-results',{recursive:true,force:true})\" && jest --config jest.e2e.config.js",
    "test:e2e:append": "jest --config jest.e2e.config.js",
    "test:all": "npm test && npm run test:e2e:append",
    "report:generate": "allure generate allure-results -o allure-report",
    "report:open": "allure open allure-report",
    "report:watch": "allure watch allure-results",
    "lint": "eslint 'src/**/*.ts' 'test/**/*.ts'",
    "migration:run": "echo 'No migrations in this phase (synchronize:true)'"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@nestjs/common": "^11.1.17",
    "@nestjs/config": "^4.0.3",
    "@nestjs/core": "^11.1.17",
    "@nestjs/platform-express": "^11.1.17",
    "@nestjs/swagger": "^11.2.6",
    "@nestjs/terminus": "^11.1.1",
    "@nestjs/throttler": "^6.5.0",
    "@nestjs/typeorm": "^11.0.0",
    "better-sqlite3": "^12.8.0",
    "helmet": "^8.1.0",
    "prom-client": "^15.1.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "typeorm": "^0.3.28"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@jest/core": "^29.7.0",
    "@nestjs/cli": "^11.0.16",
    "@nestjs/testing": "^11.1.17",
    "@types/better-sqlite3": "^7.6.13",
    "@types/express": "^5.0.6",
    "@types/jest": "^29.5.14",
    "@types/node": "^25.5.0",
    "@types/supertest": "^7.2.0",
    "@typescript-eslint/eslint-plugin": "^6.21.0",
    "@typescript-eslint/parser": "^6.21.0",
    "allure": "^3.3.1",
    "allure-jest": "^3.6.0",
    "eslint": "^8.57.1",
    "jest": "^29.7.0",
    "jest-cli": "^29.7.0",
    "jest-util": "^29.7.0",
    "prettier": "^3.8.1",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.6",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.9.3"
  }
}
