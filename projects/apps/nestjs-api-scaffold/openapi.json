{
  "openapi": "3.0.0",
  "paths": {
    "/health": {
      "get": {
        "description": "檢查服務與 DB 連線狀態",
        "operationId": "getHealth",
        "parameters": [],
        "responses": {
          "200": {
            "description": "服務正常",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    {
                      "$ref": "#/components/schemas/ApiResponseDto"
                    },
                    {
                      "properties": {
                        "data": {
                          "description": "原始回應資料（錯誤時為 null）",
                          "nullable": true,
                          "allOf": [
                            {
                              "$ref": "#/components/schemas/HealthStatusDto"
                            }
                          ]
                        }
                      }
                    }
                  ]
                }
              }
            }
          },
          "503": {
            "description": "DB 不可用",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    {
                      "$ref": "#/components/schemas/ApiResponseDto"
                    },
                    {
                      "properties": {
                        "data": {
                          "nullable": true,
                          "type": "object",
                          "example": null
                        }
                      }
                    }
                  ]
                }
              }
            }
          }
        },
        "summary": "App 健康狀態檢查",
        "tags": [
          "health"
        ]
      }
    },
    "/metrics": {
      "get": {
        "description": "回傳 prom-client 指標（http_requests_total、http_errors_total、http_request_duration_seconds）",
        "operationId": "getMetrics",
        "parameters": [],
        "responses": {
          "200": {
            "description": ""
          }
        },
        "summary": "取得 Prometheus 指標",
        "tags": [
          "metrics"
        ]
      }
    },
    "/ping": {
      "get": {
        "description": "受全域 Rate Limit 限制，可用於驗證 THROTTLE_TTL / THROTTLE_LIMIT 設定",
        "operationId": "getPing",
        "parameters": [],
        "responses": {
          "200": {
            "description": "服務可連線",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    {
                      "$ref": "#/components/schemas/ApiResponseDto"
                    },
                    {
                      "properties": {
                        "data": {
                          "description": "原始回應資料（錯誤時為 null）",
                          "nullable": true,
                          "allOf": [
                            {
                              "$ref": "#/components/schemas/PingDto"
                            }
                          ]
                        }
                      }
                    }
                  ]
                }
              }
            }
          },
          "429": {
            "description": "超過 Rate Limit"
          }
        },
        "summary": "連通性測試",
        "tags": [
          "ping"
        ]
      }
    }
  },
  "info": {
    "title": "API",
    "description": "REST API\n\n📄 [OpenAPI JSON Spec](/openapi.json)",
    "version": "1.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "schemas": {
      "ApiResponseDto": {
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean",
            "description": "是否成功",
            "example": true
          },
          "code": {
            "type": "number",
            "description": "HTTP 狀態碼",
            "example": 200
          },
          "message": {
            "type": "string",
            "description": "成功或錯誤訊息",
            "example": "OK"
          },
          "timestamp": {
            "type": "string",
            "description": "回應產生的 ISO 8601 UTC 時間字串",
            "example": "2026-03-25T12:00:00.000Z"
          },
          "traceId": {
            "type": "string",
            "description": "請求追蹤 UUID v4，可用於日誌關聯",
            "example": "a3bb189e-8bf9-3888-9912-ace4e6543002"
          }
        },
        "required": [
          "success",
          "code",
          "message",
          "timestamp",
          "traceId"
        ]
      },
      "HealthStatusDto": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "ok",
              "error"
            ],
            "description": "服務整體健康狀態",
            "example": "ok"
          },
          "details": {
            "type": "string",
            "description": "異常時的補充說明",
            "example": "db unreachable"
          }
        },
        "required": [
          "status"
        ]
      },
      "PingDto": {
        "type": "object",
        "properties": {
          "pong": {
            "type": "boolean",
            "description": "固定為 true",
            "example": true
          }
        },
        "required": [
          "pong"
        ]
      }
    }
  }
}
