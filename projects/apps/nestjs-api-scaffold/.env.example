# 環境變數設定範本
# 複製此檔案為 .env 並填入實際值
# cp .env.example .env

# 伺服器監聽連接埠（預設：3000）
PORT=3000

# SQLite 資料庫檔案路徑（預設：./data/todo.sqlite）
# 測試環境使用 :memory:
DATABASE_PATH=./data/todo.sqlite

# 執行環境（development | test | production）
NODE_ENV=development

# Rate Limit 設定（@nestjs/throttler v6.x，TTL 單位為毫秒）
# THROTTLE_TTL：時間窗口長度，單位毫秒（如：60000 = 60 秒）
# THROTTLE_LIMIT：單一 IP 在 TTL 時間窗口內的最大允許請求數
# 測試環境建議：THROTTLE_TTL=1000, THROTTLE_LIMIT=3（快速觸發 e2e 測試）
THROTTLE_TTL=60000
THROTTLE_LIMIT=100
